# WhishList App - Windows Environment Configuration\n# Copy this file to .env and fill in your actual values\n\n# ==========================================\n# SERVER CONFIGURATION\n# ==========================================\nPORT=3000\nNODE_ENV=development\nAPP_URL=http://localhost:3000\n\n# ==========================================\n# DATABASE - MongoDB Atlas (Cloud)\n# ==========================================\n# Instructions:\n# 1. Sign up at: https://www.mongodb.com/cloud/atlas\n# 2. Create free cluster (M0)\n# 3. Create database user\n# 4. Get connection string\n# 5. Replace values below\n#\n# Format: mongodb+srv://username:password@cluster.mongodb.net/database?options\n#\n# Example:\n# MONGODB_URI=mongodb+srv://wishlist_user:MyPassword123@cluster0.jxiicdd.mongodb.net/wishlist-app?retryWrites=true&w=majority\n\nMONGODB_USERNAME=wishlist_user\nMONGODB_PASSWORD=your_password_here\nMONGODB_URI=mongodb+srv://wishlist_user:your_password_here@cluster0.xxxxx.mongodb.net/wishlist-app?retryWrites=true&w=majority\n\n# ==========================================\n# AUTHENTICATION\n# ==========================================\n# JWT Secret: Generate random string for security\n# Keep this SECRET! Change before production!\n\nJWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345\n\n# ==========================================\n# ADMIN USER (for create-admin.js script)\n# ==========================================\n# These credentials will be used to create first admin account\n# Run: node create-admin.js in server folder\n\nADMIN_EMAIL=admin@wishlist.com\nADMIN_PASSWORD=admin123\nADMIN_NAME=Admin User\n\n# ==========================================\n# PAYMENT GATEWAY - Paystack\n# ==========================================\n# Get keys from: https://dashboard.paystack.com/settings/api-keys-and-webhooks\n# \n# Test Keys (for development):\n# PAYSTACK_SECRET_KEY=sk_test_...\n# PAYSTACK_PUBLIC_KEY=pk_test_...\n#\n# Live Keys (for production only):\n# PAYSTACK_SECRET_KEY=sk_live_...\n# PAYSTACK_PUBLIC_KEY=pk_live_...\n\nPAYSTACK_SECRET_KEY=sk_test_your_secret_key_here\nPAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here\n\n# ==========================================\n# SUBSCRIPTION PRICING (in Nigerian Naira)\n# ==========================================\n# All prices in NGN (₦)\n# These prices are charged monthly to vendors\n\nBASIC_PRICE_MONTHLY=9999\nPROFESSIONAL_PRICE_MONTHLY=29999\nENTERPRISE_PRICE_MONTHLY=99999\n\n# ==========================================\n# NOTES FOR WINDOWS USERS\n# ==========================================\n#\n# 1. Special Characters in Passwords:\n#    If your MongoDB password has special characters like @ or #\n#    You may need to URL-encode them:\n#    @ = %40\n#    # = %23\n#    ! = %21\n#    Example: Pass@word123 becomes Pass%40word123\n#\n# 2. File Location:\n#    Place this file at: C:\\path\\to\\WhishList\\server\\.env\n#    Use backslashes on Windows paths\n#\n# 3. Line Endings:\n#    Windows uses CRLF line endings (automatic in most editors)\n#    But some editors might use LF - either works fine\n#\n# 4. Restart Server:\n#    After editing .env, restart the server:\n#    npm run dev\n#\n# 5. No Spaces Around =\n#    CORRECT:   KEY=value\n#    WRONG:     KEY = value\n#\n# 6. No Quotes Needed\n#    CORRECT:   KEY=mongodb+srv://...\n#    WRONG:     KEY=\"mongodb+srv://...\"\n#\n# ==========================================\n# QUICK REFERENCE\n# ==========================================\n#\n# MongoDB Atlas Setup:\n#   1. Visit https://www.mongodb.com/cloud/atlas\n#   2. Sign up (free)\n#   3. Create Project\n#   4. Create Cluster (M0 free)\n#   5. Create Database User (username & password)\n#   6. Get connection string from \"Connect\" button\n#   7. Replace credentials in MONGODB_URI above\n#   8. Whitelist your IP (0.0.0.0/0 for development)\n#\n# Paystack Setup (Optional - for payments):\n#   1. Visit https://paystack.com\n#   2. Sign up for account\n#   3. Go to Settings > API Keys & Webhooks\n#   4. Copy test keys (for development)\n#   5. Use live keys only in production\n#\n# Testing Connection:\n#   In CMD, run:\n#   node -e \"require('dotenv').config(); console.log(process.env.MONGODB_URI)\"\n#\n# ==========================================\n"